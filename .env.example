# Polymarket Copy-Trading Bot V2 - Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# POLYMARKET CREDENTIALS (Required for LIVE mode)
# =============================================================================

# Private key for signing orders (LIVE mode only)
# WARNING: Keep this secret! Never share or commit!
# Export from reveal.polymarket.com or your wallet
POLYMARKET_PRIVATE_KEY=

# Your Polymarket proxy wallet address (funder)
# This is the address shown on polymarket.com/settings
# It's where you deposit USDC and where your positions are held
POLYMARKET_FUNDER_ADDRESS=

# Signature type - determines how orders are signed
# 0 = EOA (direct wallet, needs POL for gas)
# 1 = POLY_PROXY (Magic Link email login)
# 2 = GNOSIS_SAFE (browser wallet like MetaMask - most common)
POLYMARKET_SIGNATURE_TYPE=2

# =============================================================================
# OPTIONAL: PROXY CONFIGURATION
# =============================================================================
# HTTP_PROXY=
# HTTPS_PROXY=

# =============================================================================
# DATA DIRECTORY
# =============================================================================
# Override default data directory location
# DATA_DIR=./data

# =============================================================================
# LOG LEVEL OVERRIDE
# =============================================================================
# Override config file log level
# LOG_LEVEL=DEBUG
